{
  "compilerOptions": {
    "jsx": "react",
    "target": "ESNext",
    "module": "node16",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    // "baseUrl": ".",
    "rootDir": "./src",
    "outDir": "dist",
    "moduleResolution": "node16",
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"]
}
